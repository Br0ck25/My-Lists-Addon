{
  "provider": "trakt",
  "endpoint": "/users/{user}/lists/{list}/items[/movies|/shows...] (the same items as /lists/{id}/items)",
  "origin": "Written from the provider's API reference (it needs a key); the nightly live check compares it with the real thing.",
  "usedBy": [
    "fetchTrakt",
    "mapTraktItems"
  ],
  "live": {
    "needs": [
      "TRAKT_CLIENT_ID"
    ],
    "discover": {
      "url": "https://api.trakt.tv/lists/popular?limit=1",
      "headers": {
        "Content-Type": "application/json",
        "trakt-api-version": "2",
        "trakt-api-key": "{TRAKT_CLIENT_ID}"
      },
      "pick": "0.list.ids.trakt"
    },
    "request": {
      "url": "https://api.trakt.tv/lists/{DISCOVERED}/items?limit=10&page=1&extended=full",
      "headers": {
        "Content-Type": "application/json",
        "trakt-api-version": "2",
        "trakt-api-key": "{TRAKT_CLIENT_ID}"
      }
    }
  },
  "required": [
    "[]",
    "[].rank:number",
    "[].type:string",
    "[].listed_at:string",
    "[*].movie.ids.trakt:number || [*].show.ids.trakt:number"
  ],
  "headers": {
    "x-pagination-item-count": "2"
  },
