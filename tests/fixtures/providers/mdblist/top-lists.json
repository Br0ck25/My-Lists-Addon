{
  "provider": "mdblist",
  "endpoint": "api.mdblist.com/lists/top (Popular Lists)",
  "origin": "Written from the provider's API reference (it needs a key); the nightly live check compares it with the real thing.",
  "usedBy": [
    "fetchTopLists"
  ],
  "live": {
    "needs": [
      "MDBLIST_API_KEY"
    ],
    "request": {
      "url": "https://api.mdblist.com/lists/top?apikey={MDBLIST_API_KEY}"
    }
  },
  "required": [
    "[]",
    "[].name:string",
    "[].slug:string",
    "[].user_name:string",
    "[].mediatype:string",
    "[*].items:number",
    "[*].likes:number"
  ],
  "response": [
    {
